---
import {
  SITE,
  headerServices,
  servicePages,
  areaPages,
  blogPages,
  guidePages,
  labelFor,
  jsonLd,
  canonicalFor,
} from '../lib/site.js';
import '../styles/global.css';
import heroes from '../data/heroes.json';

const { page } = Astro.props;
const hero = heroes[page.slug];
const canonical = canonicalFor(page.slug);
const ld = jsonLd(page);
const current = page.slug;
/** Footer Services lists ONLY the services NOT in the header dropdown
 *  (headerServices = first 10 of servicePages), so no service is listed
 *  in both places. */
const footerServices = servicePages.filter((s) => !headerServices.includes(s));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.seo_title}</title>
    <meta name="description" content={page.meta_description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.seo_title} />
    <meta property="og:description" content={page.meta_description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    {hero && <meta property="og:image" content={SITE.base + '/images/' + hero.file} />}
    <meta name="twitter:card" content={hero ? 'summary_large_image' : 'summary'} />
    {hero && <meta name="twitter:image" content={SITE.base + '/images/' + hero.file} />}
    <meta name="twitter:title" content={page.seo_title} />
    <meta name="twitter:description" content={page.meta_description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Water Damage Restoration Midvale, home">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#E8A33D"/><path d="M32 10c8 10 14 17.5 14 26a14 14 0 1 1-28 0c0-8.5 6-16 14-26z" fill="#0B3B38"/><path d="M32 22c4.5 5.6 7.5 9.6 7.5 14a7.5 7.5 0 1 1-15 0c0-4.4 3-8.4 7.5-14z" fill="#E8A33D"/></svg>
          <span>Water Damage<br />Restoration Midvale</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          <ul>
            <li class="has-drop">
              <a href="/emergency-water-removal/" aria-haspopup="true">Services</a>
              <ul class="drop">
                {headerServices.map((s) => (
                  <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
                ))}
              </ul>
            </li>
            <li class="has-drop">
              <a href="/service-areas/" aria-haspopup="true">Areas</a>
              <ul class="drop">
                {areaPages.map((s) => (
                  <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
                ))}
                <li><a href="/service-areas/" aria-current={current === '/service-areas/' ? 'page' : undefined}>All Service Areas</a></li>
              </ul>
            </li>
            <li class="has-drop">
              <a href="/restoration-process/" aria-haspopup="true">Guides</a>
              <ul class="drop">
                {guidePages.map((s) => (
                  <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
                ))}
              </ul>
            </li>
            <li><a href="/about/" aria-current={current === '/about/' ? 'page' : undefined}>About</a></li>
            <li><a href="/contact/" aria-current={current === '/contact/' ? 'page' : undefined}>Contact</a></li>
          </ul>
        </nav>
        <a class="header-call" href={SITE.tel}>{SITE.phone}</a>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <div class="mobile-links">
            <h2>Services</h2>
            <ul>
              {headerServices.map((s) => (
                <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
              ))}
            </ul>
            <h2>Areas</h2>
            <ul>
              {areaPages.map((s) => (
                <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
              ))}
              <li><a href="/service-areas/">All Service Areas</a></li>
            </ul>
            <h2>Guides</h2>
            <ul>
              {guidePages.map((s) => (
                <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
              ))}
            </ul>
            <h2>Company</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>
        </details>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-col">
            <h2>Services</h2>
            <ul>
              {footerServices.map((s) => (
                <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
              ))}
            </ul>
          </div>
          <div class="footer-col">
            <h2>Areas We Serve</h2>
            <ul>
              {areaPages.map((s) => (
                <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
              ))}
              <li><a href="/service-areas/" aria-current={current === '/service-areas/' ? 'page' : undefined}>All Service Areas</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2>Guides</h2>
            <ul>
              {guidePages.map((s) => (
                <li><a href={s.slug} aria-current={s.slug === current ? 'page' : undefined}>{labelFor(s)}</a></li>
              ))}
            </ul>
          </div>
          <div class="footer-col">
            <h2>Company</h2>
            <ul>
              <li><a href="/" aria-current={current === '/' ? 'page' : undefined}>Home</a></li>
              <li><a href="/about/" aria-current={current === '/about/' ? 'page' : undefined}>About</a></li>
              <li><a href="/contact/" aria-current={current === '/contact/' ? 'page' : undefined}>Contact</a></li>
            </ul>
            <a class="footer-phone" href={SITE.tel}>{SITE.phone}</a>
          </div>
        </div>
        <div class="map-block">
          <h2>Find Us</h2>
          <iframe
            title="Map of the Midvale, Utah service area"
            src="https://www.google.com/maps?q=Midvale,+UT+84047&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <p class="footer-base">
          <span class="footer-brand">Water Damage Restoration Midvale</span><br />
          Water damage restoration in Midvale, Utah. Open 24 hours a day, 7 days a week.
          Call <a href={SITE.tel} style="color: var(--gold-soft);">{SITE.phone}</a> any hour.
        </p>
      </div>
    </footer>

    <div class="call-bar"><a href={SITE.tel}>{SITE.phone}</a></div>
  </body>
</html>
