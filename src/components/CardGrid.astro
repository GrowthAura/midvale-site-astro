---
import heroes from '../data/heroes.json';
// Photo cards for a doc link-list. Words and links are unchanged: the
// list item's anchor text is the card title, its ": ..." text is the card
// line, its href is the card link. The photo is the target page's own
// hero image from heroes.json; a target with no hero yet gets an honest
// deep-teal tile (no invented imagery, no fake photo).
const { cards } = Astro.props; // [{ href, title, desc }]
---

<div class="card-grid">
  {
    cards.map((c) => {
      const hero = heroes[c.href];
      return (
        <a class="card" href={c.href}>
          {hero ? (
            <span class="card-img">
              <img
                src={'/images/' + hero.file}
                srcset={'/images/' + hero.file800 + ' 800w, /images/' + hero.file + ' 1600w'}
                sizes="(max-width: 820px) 100vw, (max-width: 1020px) 50vw, 33vw"
                alt={hero.alt}
                loading="lazy"
                decoding="async"
              />
            </span>
          ) : (
            <span class="card-img card-img--empty" aria-hidden="true" />
          )}
          <span class="card-body">
            <span class="card-title">{c.title}</span>
            {c.desc && <span class="card-desc">{c.desc}</span>}
          </span>
        </a>
      );
    })
  }
</div>
