---
import Segments from './Segments.astro';
import CardGrid from './CardGrid.astro';
// Renders one page's parsed doc blocks verbatim. No words are added,
// removed or reordered here; links come only from the doc annotations
// already resolved by scripts/parse_doc.py.
//
// Pairing rules (presentation only, words unchanged):
//  - a paragraph directly before a list becomes that list's lead-in
//    inside a "facts" card ("Quick facts" on the homepage);
//  - an FAQ H3 + the paragraph that follows it stay together in one
//    .faq-item card (the paragraph is then skipped as a standalone block).
//  - a list whose items are (nearly) all links becomes a photo card grid
//    instead of bullets (see cardData/isCardList). Such a list is NOT
//    paired into a facts card: its lead-in paragraph renders standalone.
const { blocks } = Astro.props;
const slug = Astro.props.slug;

/** Design-fix round (F12/F13): these two exact H2s orphan one word on
 *  the last line at 390px even under text-wrap: balance. The class only
 *  shrinks the heading at mobile so it fits one line (see global.css);
 *  heading words are never changed. */
const TIGHT_H2 = new Set(['Protecting Your Belongings', 'Mold Remediation FAQs']);
function h2Class(t) {
  return TIGHT_H2.has(t) ? 'h2--tight' : undefined;
}

/** A list item becomes a card iff it leads with exactly one link and the
 *  rest (if any) is a single ": ..." description segment. The anchor text
 *  is the card title, the description is the card line, the href is the
 *  card link — words and links unchanged. Two-link items, plain-text
 *  items and self-links stay plain list items. */
function cardData(item) {
  const links = item.filter((s) => s.href);
  if (links.length !== 1) return null;
  if (item[0] !== links[0]) return null;
  const href = links[0].href;
  if (href === slug) return null;
  const rest = item.slice(1);
  if (rest.length === 0) return { href, title: links[0].t, desc: null };
  if (rest.length === 1 && !rest[0].href && rest[0].t.startsWith(':')) {
    return { href, title: links[0].t, desc: rest[0].t.replace(/^:\s*/, '') };
  }
  return null;
}
function isCardList(b) {
  if (b.type !== 'ul') return false;
  const elig = b.items.map(cardData).filter(Boolean).length;
  // A real index list: at least 4 link-led items and most of the list.
  // Process/step lists (2 bare links among 4-5 steps) stay plain lists.
  return elig >= 4 && elig / b.items.length >= 0.6;
}

const skip = new Set();
blocks.forEach((b, i) => {
  if (b.type === 'h3' && b.faq && blocks[i + 1]?.type === 'p') skip.add(i + 1);
});
blocks.forEach((b, i) => {
  if (b.type === 'p' && !skip.has(i) && blocks[i + 1]?.type === 'ul' && !isCardList(blocks[i + 1]))
    skip.add(i + 1);
});

// ---------- heavy closing section (text + closing round) ----------
// The trailing call block: the page's LAST H2 plus every paragraph
// after it, provided the first such paragraph holds the doc phone
// "(385) 488-1110" as plain text. That pattern is the closing on 43 of
// 44 pages (home, all 20 services, both guides, all 7 blogs, the areas
// hub, all 6 area pages, all 6 area-service pages, About). /contact/ is
// the one exception — its last H2 is "Contact FAQs", followed by FAQ
// H3s, not paragraphs — so it never matches and renders unchanged.
// Words and links stay doc-verbatim: the phone number appears exactly
// ONCE, rendered as the big gold tel: button in its original position
// in the sentence (never duplicated, never dropped), and every link
// keeps its exact anchor text and href. No new words are added.
const PHONE = '(385) 488-1110';
const PHONE_TEL = 'tel:+13854881110';
let closingStart = -1;
{
  const h2Idx = [];
  blocks.forEach((b, i) => {
    if (b.type === 'h2') h2Idx.push(i);
  });
  const last = h2Idx[h2Idx.length - 1];
  if (last !== undefined && last < blocks.length - 1) {
    const tail = blocks.slice(last + 1);
    if (
      tail.every((b) => b.type === 'p') &&
      tail[0].segments.some((s) => !s.href && s.t.includes(PHONE))
    ) {
      closingStart = last;
    }
  }
}
/** Split a closing paragraph's segments so the doc phone becomes a
 *  tel: link (kind 'phone') in place; plain text and doc links pass
 *  through untouched. Token-for-token identical to the doc text. */
function closingSegs(p) {
  const out = [];
  for (const s of p.segments) {
    if (s.href) {
      out.push({ kind: 'link', t: s.t, href: s.href });
      continue;
    }
    let rest = s.t;
    let idx = rest.indexOf(PHONE);
    while (idx >= 0) {
      if (idx > 0) out.push({ kind: 'text', t: rest.slice(0, idx) });
      out.push({ kind: 'phone', t: PHONE });
      rest = rest.slice(idx + PHONE.length);
      idx = rest.indexOf(PHONE);
    }
    if (rest) out.push({ kind: 'text', t: rest });
  }
  return out;
}
function closingClass(p) {
  const t = p.segments.map((s) => s.t).join('');
  if (t.startsWith('Serving Midvale and nearby:')) return 'closing-serving';
  if (t.startsWith('Related:')) return 'closing-related';
  return 'closing-call';
}
/** Group a closing paragraph's units so a link keeps the punctuation
 *  that follows it (", ", " · ", ".") glued to it: on mobile the bare
 *  "·" was wrapping onto a line of its own between two chips. The
 *  characters stay exactly as in the doc, in the same order — only the
 *  wrapping changes (see .closing-unit in global.css). */
function closingUnits(p) {
  const segs = closingSegs(p);
  const units = [];
  for (let k = 0; k < segs.length; k++) {
    const s = segs[k];
    if (s.kind === 'link') {
      let punct = '';
      while (
        k + 1 < segs.length &&
        segs[k + 1].kind === 'text' &&
        /^[\s,.;·]+$/.test(segs[k + 1].t)
      ) {
        punct += segs[k + 1].t;
        k++;
      }
      units.push({ kind: 'link', t: s.t, href: s.href, punct });
    } else {
      units.push(s);
    }
  }
  return units;
}
---

{
  blocks.map((b, i) => {
    if (skip.has(i)) return null;
    // Heavy closing section: the last H2 + its trailing paragraphs
    // render as one branded deep-teal panel (see .closing in
    // global.css). The H2 and every paragraph are doc-verbatim.
    if (closingStart >= 0 && i >= closingStart) {
      if (i !== closingStart) return null;
      const tail = blocks.slice(closingStart + 1);
      return (
        <section class="closing">
          <h2 class={h2Class(b.text)}>{b.text}</h2>
          {tail.map((p) => (
            <p class={closingClass(p)}>
              {closingUnits(p).map((s) =>
                s.kind === 'phone' ? (
                  <a class="closing-phone" href={PHONE_TEL}>
                    {s.t}
                  </a>
                ) : s.kind === 'link' ? (
                  <span class="closing-unit">
                    <a href={s.href}>{s.t}</a>
                    {s.punct && <span class="closing-punct">{s.punct}</span>}
                  </span>
                ) : (
                  <span>{s.t}</span>
                ),
              )}
            </p>
          ))}
        </section>
      );
    }
    const next = blocks[i + 1];
    if (b.type === 'p') {
      if (next?.type === 'ul' && !isCardList(next)) {
        return (
          <div class="facts">
            <p class="lead-in">
              <Segments segments={b.segments} />
            </p>
            <ul>
              {next.items.map((it, j) => (
                <li>
                  <Segments segments={it} />
                </li>
              ))}
            </ul>
          </div>
        );
      }
      return (
        <p>
          <Segments segments={b.segments} />
        </p>
      );
    }
    if (b.type === 'ul') {
      if (isCardList(b)) {
        const cards = [];
        const plain = [];
        b.items.forEach((it) => {
          const c = cardData(it);
          if (c) cards.push(c);
          else plain.push(it);
        });
        return (
          <>
            <CardGrid cards={cards} />
            {plain.length > 0 && (
              <ul>
                {plain.map((it) => (
                  <li>
                    <Segments segments={it} />
                  </li>
                ))}
              </ul>
            )}
          </>
        );
      }
      return (
        <ul>
          {b.items.map((it, j) => (
            <li>
              <Segments segments={it} />
            </li>
          ))}
        </ul>
      );
    }
    if (b.type === 'h2') return <h2 class={h2Class(b.text)}>{b.text}</h2>;
    if (b.type === 'h3') {
      if (b.faq && next?.type === 'p') {
        return (
          <div class="faq-item">
            <h3>{b.text}</h3>
            <p>
              <Segments segments={next.segments} />
            </p>
          </div>
        );
      }
      return <h3>{b.text}</h3>;
    }
    if (b.type === 'table') {
      // Fix Round 2: column count decides the mobile treatment. Tables
      // with 3 or fewer columns fit the 350px wrapper with fixed layout
      // and read cleanly; 4+ column tables get .table-wrap--wide, which
      // restores intact horizontal scrolling instead of shattering words
      // (a 4-col table squeezed to ~87px columns broke nearly every long
      // word mid-word). Words unchanged; presentation class only.
      // Fix Round 3: with break-word removed (overflow-wrap: normal),
      // 13 more ≤3-col tables overflow their fixed ~117px columns by
      // 5–26px (one long word per table: 'Submersible pump',
      // 'Dehumidifiers', 'Antimicrobial', 'Dishwasher', 'groundwater',
      // 'professional', ... — measured per-cell scrollWidth > clientWidth
      // at 390px, qa/fix-round3/results-render.json). Per the Round 3
      // rule those tables get the wide scroll treatment too, keyed here
      // by slug + table ordinal (0-based among the page's tables).
      // Measured clean after this change: 0 overflowing cells, 0
      // mid-word splits sitewide at 390px.
      const WIDE_TABLES = new Set([
        '/emergency-water-removal/#0',
        '/ice-dam-water-damage/#0',
        '/basement-flooding-cleanup/#0',
        '/basement-flooding-cleanup/#1',
        '/mold-remediation/#0',
        '/flood-damage-restoration/#0',
        '/water-heater-leak-cleanup/#0',
        '/appliance-leak-water-damage/#0',
        '/wet-carpet-drying/#0',
        '/hardwood-floor-water-damage/#0',
        '/restoration-process/#0',
        '/insurance-claims-help/#0',
        '/blog/how-long-does-water-damage-take-to-dry/#0',
      ]);
      const cols = Math.max(...b.rows.map((row) => row.length));
      const tableOrdinal = blocks.slice(0, i).filter((x) => x.type === 'table').length;
      const forceWide = WIDE_TABLES.has(`${Astro.props.slug}#${tableOrdinal}`);
      return (
        <div class={cols >= 4 || forceWide ? 'table-wrap table-wrap--wide' : 'table-wrap'}>
          <table>
            {b.rows.map((row, ri) => (
              <tr>
                {row.map((cell, ci) =>
                  ri === 0 && b.has_header !== false ? (
                    <th scope="col">
                      <Segments segments={cell} />
                    </th>
                  ) : (
                    <td>
                      <Segments segments={cell} />
                    </td>
                  ),
                )}
              </tr>
            ))}
          </table>
        </div>
      );
    }
    if (b.type === 'cta') {
      return (
        <div class="cta-row">
          {b.buttons.map((btn) =>
            btn.tel ? (
              <a class="btn btn-gold" href={btn.tel}>
                {btn.label}
              </a>
            ) : (
              <a class="btn btn-teal" href={btn.href}>
                {btn.label}
              </a>
            ),
          )}
        </div>
      );
    }
    return null;
  })
}
