---
import Layout from '../layouts/Layout.astro';
import Blocks from '../components/Blocks.astro';
import HotServices from '../components/HotServices.astro';
import Segments from '../components/Segments.astro';
import { pages } from '../lib/site.js';
import heroes from '../data/heroes.json';

export async function getStaticPaths() {
  return pages.map((p) => ({
    params: { slug: p.slug === '/' ? undefined : p.slug.replace(/^\/|\/$/g, '') },
    props: { page: p },
  }));
}

const { page } = Astro.props;
const hero = heroes[page.slug];
const heroClass =
  'hero' +
  (page.slug === '/areas/cottonwood-heights/' ? ' hero--tight' : '') +
  (hero ? ' has-hero' : '');
const blocks = page.blocks;

// Hero = the doc H1 + the first paragraph after it + a CTA block if it
// follows immediately. Everything else renders in the article body.
// (All three are doc content; the hero is presentation, not new words.)
const h1Idx = blocks.findIndex((b) => b.type === 'h1');
const h1 = blocks[h1Idx];
const intro = blocks[h1Idx + 1]?.type === 'p' ? blocks[h1Idx + 1] : null;
const ctaIdx = h1Idx + (intro ? 2 : 1);
const heroCta = blocks[ctaIdx]?.type === 'cta' ? blocks[ctaIdx] : null;
const bodyBlocks = blocks.filter(
  (b, i) => i !== h1Idx && b !== intro && b !== heroCta,
);
---

<Layout page={page}>
  <main class={page.slug === '/areas/south-jordan/' ? 'faq-tight' : undefined}>
    <section class={heroClass}>
      {
        hero && (
          <img
            class="hero-img"
            src={'/images/' + hero.file}
            srcset={'/images/' + hero.file800 + ' 800w, /images/' + hero.file + ' 1600w'}
            sizes="100vw"
            alt={hero.alt}
            fetchpriority="high"
            decoding="async"
          />
        )
      }
      <div class="wrap">
        <h1>{h1.text}</h1>
        {
          intro && (
            <p class="hero-intro">
              <Segments segments={intro.segments} />
            </p>
          )
        }
        {
          heroCta && (
            <div class="hero-ctas">
              {heroCta.buttons.map((btn) =>
                btn.tel ? (
                  <a class="btn btn-gold" href={btn.tel}>
                    {btn.label}
                  </a>
                ) : (
                  <a class="btn btn-outline" href={btn.href}>
                    {btn.label}
                  </a>
                ),
              )}
            </div>
          )
        }
      </div>
    </section>
    <div class="wrap article">
      <Blocks blocks={bodyBlocks} slug={page.slug} />
    </div>
    {/* Hot Services (user-ordered, area pages only): after the article
        content, before the footer — the article ends on its call CTA,
        so the section reads as the next step, not an interruption. */}
    <HotServices slug={page.slug} />
  </main>
</Layout>
